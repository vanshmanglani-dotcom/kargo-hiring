# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to the browser

# Google AI Studio → API key (enable billing so your inputs are not used for training)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Resend → API Keys (leave blank until checkpoint B-2)
RESEND_API_KEY=
EMAIL_FROM=Arjun at Kargo <onboarding@resend.dev>

# Protects the dashboard (it holds candidate PII). Username: anything. Leave blank to disable.
DASHBOARD_PASSWORD=change-me

# How many candidates per role get an interview invite draft
SHORTLIST_SIZE=5
